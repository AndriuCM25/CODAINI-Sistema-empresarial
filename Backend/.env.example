# =====================================================================
# CODAINI - Configuración de Entorno Backend
# =====================================================================

# Aplicación
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Base de Datos (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=codaini_db
DB_USER=root
DB_PASS=

# Seguridad y Autenticación JWT
JWT_SECRET=codaini_jwt_secure_super_secret_key_2025_replace_in_prod
JWT_EXPIRE=86400
JWT_ALGO=HS256

# CORS (Orígenes permitidos separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
